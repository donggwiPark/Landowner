# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KAKAO_CLIENT_ID: 카카오 디벨로퍼스에서 발급 받은 REST API 키
KAKAO_CLIENT_ID=""

# KAKAO_CLIENT_SECRET: 카카오 디벨로퍼스 > 보안 메뉴에서 활성화한 Client Secret (활성화한 경우 필수)
KAKAO_CLIENT_SECRET=""

# KAKAO_REDIRECT_URI: 카카오 로그인의 리다이렉트 URI (설정하지 않으면 자동으로 앱 URL에 맞춰집니다)
KAKAO_REDIRECT_URI=""

# ==========================================
# GOOGLE SPREADSHEETS PASSWORDLESS CONFIG (무인 연동 환경변수)
# ==========================================
# 1. Apps Script 방식 (가장 간편): Apps Script 웹 앱 배포 완료 후 발급받은 EXECUTIVE URL 주소
GOOGLE_APPS_SCRIPT_URL=""

# 2. 서비스 계정 방식 (GCP): 구글 Cloud Console에서 발급받은 서비스 계정 JSON 전체 스트링 (쌍따옴표로 감싸서 한줄로 기입)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# 3. OAuth 서버단 리프레시 토큰 방식
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# 기본 전초 스프레드시트 ID (미지정 시 기본 견본 사용)
GOOGLE_SPREADSHEET_ID=""

